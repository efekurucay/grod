{
  "$description": "grod UI tokens, DTCG 2025.10. Warm low-chroma neutrals; color carries state only. ui/build.mjs turns this into CSS variables.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": { "colorSpace": "oklch", "components": [0.970, 0.005, 85] } },
      "surface": { "$value": { "colorSpace": "oklch", "components": [0.990, 0.003, 85] } },
      "muted": { "$value": { "colorSpace": "oklch", "components": [0.935, 0.006, 85] } },
      "foreground": { "$value": { "colorSpace": "oklch", "components": [0.280, 0.008, 75] } },
      "muted-foreground": { "$value": { "colorSpace": "oklch", "components": [0.500, 0.010, 75] } },
      "border": { "$value": { "colorSpace": "oklch", "components": [0.895, 0.007, 85] }, "$description": "Decorative only (1.26:1); never the only boundary of a control." },
      "input": { "$value": { "colorSpace": "oklch", "components": [0.640, 0.010, 80] }, "$description": "Control boundary, 3:1 on background." },
      "primary": { "$value": { "colorSpace": "oklch", "components": [0.320, 0.008, 75] } },
      "primary-foreground": { "$value": "{color.light.background}" },
      "accent": { "$value": { "colorSpace": "oklch", "components": [0.520, 0.050, 150] }, "$description": "Sage. Means \"on\"; at most one per screen." },
      "accent-foreground": { "$value": "{color.light.surface}" },
      "caution": { "$value": { "colorSpace": "oklch", "components": [0.540, 0.070, 60] }, "$description": "Clay, deliberately not red." },
      "ring": { "$value": { "colorSpace": "oklch", "components": [0.580, 0.040, 150] } }
    },
    "dark": {
      "background": { "$value": { "colorSpace": "oklch", "components": [0.215, 0.004, 75] } },
      "surface": { "$value": { "colorSpace": "oklch", "components": [0.250, 0.005, 75] } },
      "muted": { "$value": { "colorSpace": "oklch", "components": [0.280, 0.005, 75] } },
      "foreground": { "$value": { "colorSpace": "oklch", "components": [0.910, 0.008, 85] } },
      "muted-foreground": { "$value": { "colorSpace": "oklch", "components": [0.700, 0.010, 80] } },
      "border": { "$value": { "colorSpace": "oklch", "components": [0.330, 0.006, 75] } },
      "input": { "$value": { "colorSpace": "oklch", "components": [0.520, 0.008, 80] } },
      "primary": { "$value": { "colorSpace": "oklch", "components": [0.880, 0.008, 85] } },
      "primary-foreground": { "$value": "{color.dark.background}" },
      "accent": { "$value": { "colorSpace": "oklch", "components": [0.740, 0.060, 150] } },
      "accent-foreground": { "$value": "{color.dark.background}" },
      "caution": { "$value": { "colorSpace": "oklch", "components": [0.760, 0.070, 65] } },
      "ring": { "$value": { "colorSpace": "oklch", "components": [0.640, 0.045, 150] } }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["system-ui", "-apple-system", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "12": { "$value": { "value": 12, "unit": "px" } },
      "13": { "$value": { "value": 13, "unit": "px" }, "$description": "Popup body." },
      "14": { "$value": { "value": 14, "unit": "px" } },
      "16": { "$value": { "value": 16, "unit": "px" }, "$description": "Page body." },
      "20": { "$value": { "value": 20, "unit": "px" } },
      "24": { "$value": { "value": 24, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "strong": { "$value": 600 }
    },
    "leading": {
      "$type": "number",
      "body": { "$value": 1.5 },
      "heading": { "$value": 1.25 }
    }
  },
  "space": {
    "$type": "dimension",
    "4": { "$value": { "value": 4, "unit": "px" } },
    "8": { "$value": { "value": 8, "unit": "px" } },
    "12": { "$value": { "value": 12, "unit": "px" } },
    "16": { "$value": { "value": 16, "unit": "px" } },
    "24": { "$value": { "value": 24, "unit": "px" } },
    "32": { "$value": { "value": 32, "unit": "px" } },
    "48": { "$value": { "value": 48, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 6, "unit": "px" } },
    "lg": { "$value": { "value": 10, "unit": "px" } }
  },
  "duration": {
    "$type": "duration",
    "$description": "Every duration becomes 0ms under prefers-reduced-motion: reduce.",
    "instant": { "$value": { "value": 0, "unit": "ms" } },
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "slow": { "$value": { "value": 180, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "out": { "$value": [0, 0, 0.58, 1] }
  }
}
