{
  "$schema": "./grod.rules.schema.json",
  "schemaVersion": 1,
  "rules": [
    {
      "id": "instagram",
      "title": "Instagram",
      "why": "Scrolling Instagram pauses you every minute, a little longer each time. Stories, posts and DMs stay.",
      "enabled": true,
      "web": {
        "hosts": [
          "instagram.com"
        ],
        "block": [
          "^/reels(/|\\?|$)"
        ]
      },
      "android": {
        "packages": [
          "com.instagram.android"
        ]
      }
    },
    {
      "id": "youtube",
      "title": "YouTube",
      "why": "Scrolling YouTube pauses you every minute, a little longer each time. Search and videos stay; a Short opens as a normal video on the web.",
      "enabled": true,
      "web": {
        "hosts": [
          "youtube.com"
        ],
        "redirect": [
          {
            "from": "^/shorts/([A-Za-z0-9_-]+).*",
            "to": "/watch?v=$1"
          }
        ]
      },
      "android": {
        "packages": [
          "com.google.android.youtube",
          "app.revanced.android.youtube"
        ]
      }
    },
    {
      "id": "tiktok",
      "title": "TikTok",
      "why": "TikTok is all feed. The website stays closed; in the app, scrolling pauses you every minute.",
      "enabled": true,
      "web": {
        "hosts": [
          "tiktok.com"
        ],
        "block": [
          "^/"
        ]
      },
      "android": {
        "packages": [
          "com.zhiliaoapp.musically",
          "com.ss.android.ugc.trill"
        ]
      }
    },
    {
      "id": "facebook",
      "title": "Facebook",
      "why": "Scrolling Facebook pauses you every minute, a little longer each time. Groups and Messenger stay.",
      "enabled": true,
      "web": {
        "hosts": [
          "facebook.com"
        ],
        "block": [
          "^/reel/"
        ]
      },
      "android": {
        "packages": [
          "com.facebook.katana"
        ]
      }
    },
    {
      "id": "snapchat",
      "title": "Snapchat",
      "why": "Scrolling Snapchat pauses you every minute, a little longer each time. Chats and Stories stay.",
      "enabled": true,
      "android": {
        "packages": [
          "com.snapchat.android"
        ]
      }
    },
    {
      "id": "x",
      "title": "X",
      "why": "Scrolling X pauses you every minute, a little longer each time. Posts and messages stay.",
      "enabled": true,
      "web": {
        "hosts": [
          "x.com",
          "twitter.com"
        ]
      },
      "android": {
        "packages": [
          "com.twitter.android"
        ]
      }
    },
    {
      "id": "linkedin",
      "title": "LinkedIn",
      "why": "Scrolling the LinkedIn feed pauses you every minute, a little longer each time. Messages, jobs and profiles stay.",
      "enabled": true,
      "web": {
        "hosts": [
          "linkedin.com"
        ]
      },
      "android": {
        "packages": [
          "com.linkedin.android"
        ]
      }
    }
  ],
  "scroll": {
    "freeSeconds": 60,
    "firstPauseSeconds": 10,
    "growth": 2,
    "maxPauseSeconds": 300,
    "resetMinutes": 15
  },
  "opening": {
    "awayMinutes": 5,
    "quickMinutes": 2
  },
  "notifications": {
    "enabled": true,
    "deliverEvery": 60,
    "allow": [
      {
        "category": "event"
      },
      {
        "category": "reminder"
      }
    ],
    "keepDays": 30,
    "deliverAt": [
      "08:30",
      "12:30",
      "15:30",
      "18:30",
      "21:30"
    ]
  },
  "review": {
    "weekday": 7,
    "time": "20:00"
  },
  "launcher": {
    "distracting": [],
    "hidden": []
  },
  "revision": "83a3f725fc1d"
}
